# Server Configuration
PORT=3000

# Image Processing Configuration
# Maximum image/video size in bytes (default: 10MB, recommended for videos: 50MB)
MAX_IMAGE_SIZE=50000000

# Request timeout in milliseconds (default: 10000, recommended for videos: 60000)
REQUEST_TIMEOUT=60000

# Cache Configuration
# Maximum number of cached images (default: 100)
CACHE_MAX_SIZE=100

# Cache TTL in milliseconds (default: 3600000 = 1 hour)
CACHE_TTL=3600000
